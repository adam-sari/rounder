# Cloudflare Pages headers. No COOP/COEP on purpose: tools avoid SharedArrayBuffer so ad iframes keep working.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# hashed build output never changes
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# vendored wasm, fonts and models change only with a deploy
/vendor/*
  Cache-Control: public, max-age=2592000
/fonts/*
  Cache-Control: public, max-age=31536000
/models/*
  Cache-Control: public, max-age=2592000

/og/*
  Cache-Control: public, max-age=86400
