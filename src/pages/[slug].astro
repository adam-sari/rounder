---
import Base from '@/layouts/Base.astro';
import ToolHost from '@/components/tool/ToolHost.svelte';
import ToolCard from '@/components/site/ToolCard.astro';
import CategoryArt from '@/components/art/CategoryArt.astro';
import { tools, toolBySlug, toolsIn, splitEmphasis, plainText, type Tool } from '@/tools/registry';
import { categoryById, categoryPath } from '@/tools/categories';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.slug }, props: { tool } }));
}

const { tool } = Astro.props as { tool: Tool };
const category = categoryById[tool.category];
const url = new URL(`/${tool.slug}`, Astro.site).href;

// explicit related tools first, then fill from the same category
const related = [
  ...(tool.related ?? []).map((s) => toolBySlug[s]).filter(Boolean),
  ...toolsIn(tool.category).filter((t) => t.slug !== tool.slug && !tool.related?.includes(t.slug)),
].slice(0, 6);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: plainText(tool.h1),
    url,
    description: tool.description,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (runs in the browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: tool.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Rounder', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: `${category.name} tools`, item: new URL(categoryPath(category.id), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: tool.name, item: url },
    ],
  },
];
---

<Base title={tool.title} description={tool.description} schema={schema} ogImage={`/og/${tool.slug}.png`}>
  <article class="wrap max-w-[1040px]!">
    <nav class="mono mt-6" aria-label="Breadcrumb">
      <a href="/" class="no-underline hover:text-chalk">index</a> /
      <a href={categoryPath(category.id)} class="no-underline hover:text-chalk">{category.id}</a> /
      <span class="text-chalk">{tool.slug}</span>
    </nav>

    <header class="mt-4 mb-8 flex items-center gap-5">
      <CategoryArt kind={tool.category} spot={category.spot} ink="var(--color-chalk)" size={84} class="hidden shrink-0 sm:block" />
      <div>
        <h1 class="text-[clamp(44px,6vw,80px)] leading-[0.95]">
          {splitEmphasis(tool.h1).map((p) => (p.em ? <em>{p.text}</em> : p.text))}
        </h1>
        <p class="mt-3 text-lg text-soft">{tool.tagline}</p>
      </div>
    </header>

    <section class="card p-[clamp(16px,3vw,32px)]" aria-label="Tool">
      <ToolHost client:load island={tool.island} props={tool.props} />
    </section>

    <div class="mt-20 grid gap-12 md:grid-cols-[1fr_1.3fr]">
      <section>
        <h2 class="text-4xl">How it works</h2>
        <ol class="mt-5 grid gap-4">
          {tool.steps.map((step, i) => (
            <li class="flex gap-4">
              <span class="mono pt-1">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-soft">{step}</span>
            </li>
          ))}
        </ol>
      </section>
      <section>
        <h2 class="text-4xl">Questions</h2>
        <div class="mt-5 grid gap-2">
          {tool.faq.map((f) => (
            <details class="card group px-5 py-4">
              <summary class="cursor-pointer list-none font-medium marker:hidden">
                <span class="mono mr-2 inline-block transition-transform group-open:rotate-90">›</span>{f.q}
              </summary>
              <p class="mt-2 text-soft">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    </div>

    {related.length > 0 && (
      <section class="mt-20">
        <h2 class="text-4xl">More {category.name.toLowerCase()} tools</h2>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((t) => <ToolCard tool={t} />)}
        </div>
      </section>
    )}
  </article>
</Base>
