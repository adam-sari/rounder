---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  updated?: string;
}

const { title, description, heading, updated } = Astro.props;
// Trust and legal pages (privacy, terms, about, security…) never carry ads or the consent tag: the consent message
// links to /privacy, and AdSense requires that page to be free of both. So Prose never passes an `ads` prop to Base.
---

<Base title={title} description={description}>
  <article class="wrap prose-page max-w-[760px]!">
    <h1 class="mt-10 text-[clamp(48px,7vw,88px)] leading-[0.95]" set:html={heading} />
    {updated && <p class="mono mt-3">last updated {updated}</p>}
    <div class="mt-10"><slot /></div>
  </article>
</Base>

<style>
  .prose-page :global(h2) {
    margin: 48px 0 12px;
    font-size: 34px;
    line-height: 1.1;
  }
  .prose-page :global(h3) {
    margin: 32px 0 8px;
    font-size: 24px;
    line-height: 1.15;
  }
  .prose-page :global(p),
  .prose-page :global(li) {
    color: var(--color-soft);
    font-size: 17px;
  }
  .prose-page :global(p) {
    margin: 0 0 16px;
  }
  .prose-page :global(ul) {
    margin: 0 0 16px;
    padding-left: 20px;
    list-style: disc;
  }
  .prose-page :global(li) {
    margin-bottom: 6px;
  }
  .prose-page :global(strong) {
    color: var(--color-chalk);
    font-weight: 500;
  }
  .prose-page :global(a) {
    color: var(--color-sun);
  }
  .prose-page :global(ol) {
    margin: 0 0 16px;
    padding-left: 22px;
    list-style: decimal;
  }
  .prose-page :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    color: var(--color-chalk);
    overflow-wrap: anywhere;
  }
</style>
