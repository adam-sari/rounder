---
import Mascot from '@/components/art/Mascot.astro';
---

<header class="wrap flex items-center justify-between gap-4 py-5">
  <a href="/" class="flex items-center gap-2.5 font-serif text-[30px] leading-none no-underline" aria-label="Rounder home">
    <Mascot size={32} rough={false} spot="var(--color-sun)" ink="var(--color-chalk)" face="var(--color-bg)" />
    rounder
  </a>
  <nav class="flex items-center gap-5 mono" aria-label="Main">
    <a href="/#tools" class="hidden sm:inline no-underline hover:text-chalk">all tools</a>
    <a href="/why-free" class="hidden sm:inline no-underline hover:text-chalk">why free</a>
    <button
      type="button"
      data-open-palette
      class="flex items-center gap-3 rounded-full border border-line-2 bg-panel py-1.5 pr-1.5 pl-3.5 text-soft hover:border-muted cursor-pointer"
    >
      <span>search</span>
      <kbd class="rounded-md bg-panel-2 px-1.5 py-0.5 text-[11px] text-muted">⌘K</kbd>
    </button>
  </nav>
</header>
