---
import { categories, categoryPath } from '@/tools/categories';
import { toolsIn } from '@/tools/registry';
import { SITE } from '@/site';

const liveCategories = categories.filter((c) => toolsIn(c.id).length > 0);
// trust pages are linked once they exist, so the footer never points at a missing page
const pages = new Set(Object.keys(import.meta.glob('/src/pages/*.astro')).map((p) => p.slice('/src/pages/'.length, -'.astro'.length)));
const about = [
  ['about', 'About'],
  ['why-free', "Why it's free"],
  ['security', 'Security'],
  ['privacy', 'Privacy'],
  ['terms', 'Terms'],
  ['contact', 'Contact'],
  ['press', 'Press'],
  ['credits', 'Credits'],
].filter(([slug]) => pages.has(slug));
const developers = Object.keys(import.meta.glob('/src/pages/developers/index.astro')).length > 0;
---

<footer class="wrap mt-32 pb-16">
  <div class="grid gap-10 border-t border-line-2 pt-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-serif text-4xl leading-none">rounder</p>
      <p class="mt-3 max-w-sm text-soft">
        Small tools, done properly. Free, no sign-ups, and your files never leave your device. Kept free by a few polite ads.
      </p>
      {SITE.donate && (
        <p class="mt-3 text-soft">
          Saved you some time? <a href={SITE.donate} rel="noopener" class="text-sun">Buy Roundy a coffee</a>.
        </p>
      )}
    </div>
    <nav aria-label="Categories">
      <p class="mono mb-3">categories</p>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-1.5 text-soft">
        {liveCategories.map((c) => <li><a href={categoryPath(c.id)} class="no-underline hover:text-chalk">{c.name}</a></li>)}
      </ul>
    </nav>
    <nav aria-label="About">
      <p class="mono mb-3">about</p>
      <ul class="grid gap-1.5 text-soft">
        {about.map(([slug, label]) => <li><a href={`/${slug}`} class="no-underline hover:text-chalk">{label}</a></li>)}
        {/* the AGPL asks a network service to offer its source; this is where */}
        {developers && <li><a href="/developers" class="no-underline hover:text-chalk">Developers</a></li>}
        {SITE.github && <li><a href={SITE.github} class="no-underline hover:text-chalk">Source code</a></li>}
        <li hidden data-consent-settings>
          <button type="button" class="cursor-pointer text-left hover:text-chalk">Privacy &amp; cookie settings</button>
        </li>
      </ul>
    </nav>
  </div>
  <p class="mono mt-10">© {new Date().getFullYear()} rounder · roundertools.com</p>
</footer>

<script is:inline>
  // Google's consent message (part of the ad tag) can be reopened from here. The link appears only once that
  // message is running and GDPR applies to this visitor (EEA, UK, Switzerland), as in Google's Privacy & messaging
  // API example, so pages without ads, and visitors who were never asked, don't see a link that does nothing.
  window.googlefc = window.googlefc || {};
  googlefc.callbackQueue = googlefc.callbackQueue || [];
  googlefc.callbackQueue.push({
    CONSENT_DATA_READY: () => {
      if (typeof window.__tcfapi !== 'function') return;
      window.__tcfapi('addEventListener', 2, (tcData, success) => {
        const show = !!(success && tcData && tcData.gdprApplies);
        document.querySelectorAll('[data-consent-settings]').forEach((el) => (el.hidden = !show));
      });
    },
  });
  document.addEventListener('click', (e) => {
    if (e.target.closest?.('[data-consent-settings] button')) googlefc.callbackQueue.push(() => googlefc.showRevocationMessage());
  });
</script>
